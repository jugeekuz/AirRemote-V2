{
  "name": "airremote",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "device-sim": "pnpm --silent --filter @airremote/device-sim start --",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts && tsc -p firmware/e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:firmware": "vitest run --project firmware",
    "db:generate": "pnpm --filter @airremote/db generate",
    "db:migrate": "pnpm --filter @airremote/db migrate",
    "openapi": "pnpm --silent --filter @airremote/backend openapi"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
