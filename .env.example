# Postgres container credentials (docker-compose `db` service)
POSTGRES_USER=airremote
POSTGRES_PASSWORD=airremote
POSTGRES_DB=airremote

# Connection string used when running the API or migrations on the host
DATABASE_URL=postgres://airremote:airremote@localhost:5432/airremote

# Address and port the API listens on
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# development | production | test (development enables pretty logs)
NODE_ENV=development

# Where migrations are read from; blank uses packages/db/migrations
MIGRATIONS_FOLDER=
