# Postgres container credentials (docker-compose `db` service)
POSTGRES_USER=airremote
POSTGRES_PASSWORD=airremote
POSTGRES_DB=airremote

# Connection string used when running the API or migrations on the host
DATABASE_URL=postgres://airremote:airremote@localhost:5432/airremote

# Address and port the API listens on
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# development | production | test (development enables pretty logs)
NODE_ENV=development

# Where migrations are read from; blank uses packages/db/migrations
MIGRATIONS_FOLDER=

# Secrets that sign access and refresh tokens: at least 32 characters each and
# different from each other. Generate real ones with `openssl rand -hex 32`.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789

# Keys the stored hashes of device pairing codes, so a copy of the database
# alone cannot recover them. At least 32 characters.
PAIRING_CODE_SECRET=dev-only-pairing-secret-change-me-0123456789

# Device listener (mTLS WebSockets). Port devices connect to.
DEVICE_PORT=8443
# Server certificate, its key, and the CA that signs device certificates (PEM).
# Set all three or none; none keeps the device listener off. Host paths, used by
# `pnpm dev` (absolute recommended). Docker Compose expects the files in ./certs
# as device-server.crt, device-server.key and device-ca.crt.
DEVICE_TLS_CERT_FILE=
DEVICE_TLS_KEY_FILE=
DEVICE_TLS_CA_FILE=

# Origins allowed to call the API from a browser with credentials, comma-separated
# (scheme + host + optional port, no path). Blank allows none. The Expo web dev
# server is http://localhost:8081.
CORS_ORIGINS=http://localhost:8081
