# FireBeetle ESP32 (DFR0478), 16 MB flash.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The table sits at 0x10000, not 0x8000, leaving room for a larger bootloader
# once secure boot and flash encryption are on.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# A bootloader setting, so it is on from the first flash: an OTA image that
# never marks itself valid is rolled back on the next boot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Crash dumps to the coredump partition, to read after a reboot.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# Device runs on the main task, which also builds JSON and TLS configs.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# The IR receiver's ISR re-arms the next capture itself (parts can be ~5 ms
# apart), which needs rmt_receive in IRAM.
CONFIG_RMT_RECV_FUNC_IN_IRAM=y
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=y
